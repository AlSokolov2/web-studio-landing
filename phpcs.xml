<?xml version="1.0"?>
<ruleset name="Web Studio">
    <description>WordPress Coding Standards — spaces instead of tabs.</description>

    <rule ref="WordPress-Extra">
        <!-- Project uses 4-space indentation instead of tabs -->
        <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
        <exclude name="Universal.WhiteSpace.PrecisionAlignment"/>
    </rule>

    <!-- Enforce 4-space indentation -->
    <rule ref="Generic.WhiteSpace.ScopeIndent">
        <properties>
            <property name="indent" value="4"/>
            <property name="tabIndent" value="false"/>
        </properties>
    </rule>

    <!-- Only scan PHP files -->
    <arg name="extensions" value="php"/>

    <!-- Exclude paths -->
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/assets/*</exclude-pattern>
    <exclude-pattern>/languages/*</exclude-pattern>
    <exclude-pattern>/index.php</exclude-pattern>
    <exclude-pattern>/style.css</exclude-pattern>
    <exclude-pattern>*.css</exclude-pattern>
    <exclude-pattern>*.md</exclude-pattern>
    <exclude-pattern>*.js</exclude-pattern>

    <file>./</file>
</ruleset>
